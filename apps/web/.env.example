# Optional. Defaults to http://localhost:3001/api (see src/lib/api.ts) so
# local dev works without this file. Only needed to point at a different
# API — e.g. when building the Docker image, where it must resolve inside
# the web container's own network (the compose service name, not
# "localhost" — see docker-compose.yml).
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
